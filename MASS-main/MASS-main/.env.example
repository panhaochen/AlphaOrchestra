MASS_LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
MASS_LLM_API_KEY=sk-your-api-key
MASS_CHAT_MODEL=deepseek-chat
MASS_REASONING_MODEL=deepseek-reasoner
MASS_VISION_MODEL=qwen
MASS_LLM_MAX_TOKENS=4096
MASS_LLM_REQUESTS_PER_MINUTE=10
MASS_LLM_TOKENS_PER_MINUTE=300000
MASS_LLM_TOKENS_PER_WEEK=1000000000
MASS_LLM_CACHE_MODE=readwrite
# MASS_LLM_CACHE_DIR=D:\path\to\llm_cache
MASS_LLM_INPUT_COST_PER_MILLION=0
MASS_LLM_OUTPUT_COST_PER_MILLION=0

# Optional path overrides.
# MASS_DATASET_DIR=D:\path\to\dataset
# MASS_RESULT_DIR=D:\path\to\result
